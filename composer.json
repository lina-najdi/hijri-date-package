{
    "name": "lina/hijri-date",
    "description": "A simple Laravel package for Hijri dates.",
    "type": "library",
  "require": {
        "php": "^8.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Lina\\HijriDate\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lina\\HijriDate\\HijriDateServiceProvider"
            ],
            "aliases": {
                "Hijri": "Lina\\HijriDate\\Facades\\Hijri"
            }
        }
    }
}